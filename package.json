{
  "name": "the-hollow",
  "private": true,
  "type": "module",
  "description": "The Hollow: a deck-building hex RPG prototype (single-device browser build).",
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhector/spellcrafter"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:scripts": "node --test .github/scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:scripts && npm run build",
    "design:mirror": "node .github/scripts/design-mirror.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "marked": "^18.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
