{
  "name": "the-hollow",
  "private": true,
  "type": "module",
  "description": "The Hollow: a deck-building hex RPG prototype (single-device browser build).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:scripts": "node --test .github/scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:scripts && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
